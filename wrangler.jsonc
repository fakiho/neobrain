{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neobrain",
  "compatibility_date": "2026-04-05",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "assets": {
    "directory": "website"
  }
}
