{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neobrain",
  "compatibility_date": "2026-04-05",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  // Cloudflare Workers Builds runs `npx wrangler preview` for per-branch PR
  // preview builds; wrangler >=4.156 errors with "Your Wrangler configuration
  // is missing a `previews` block" without it. Assets/compatibility stay at
  // top level.
  "previews": {},
  "assets": {
    "directory": "website"
  }
}
