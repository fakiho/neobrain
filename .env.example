# neoBrain configuration (copy to .env — never commit .env)

# --- Data ---
NEOBRAIN_DATA_DIR=./data

# --- API / dashboard ---
NEOBRAIN_API=http://127.0.0.1:9192

# --- Embeddings (local-first default) ---
NEOBRAIN_EMBED_PROVIDER=ollama
NEOBRAIN_EMBED_URL=http://127.0.0.1:11434
NEOBRAIN_EMBED_MODEL=embeddinggemma

# --- LLM runtime (OpenAI-compatible; in-house LiteLLM gateway by default) ---
NEOBRAIN_LLM_BASE_URL=http://127.0.0.1:4000/v1
NEOBRAIN_LLM_API_KEY=
NEOBRAIN_LLM_MODEL_CHEAP=deepseek/deepseek-flash
NEOBRAIN_LLM_MODEL_STRONG=deepseek/deepseek-v4-pro

# --- Sources (workspace docs, repos, opencode session DB) ---
NEOBRAIN_WORKSPACE=
